# Never commit .env.local or put these values in NEXT_PUBLIC_ variables.
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# A random password of at least 32 characters (see README).
SESSION_SECRET=
# Picker key restricted to this app's origins and the Google Picker API.
GOOGLE_PICKER_API_KEY=
# Google Cloud project NUMBER (not project ID), same project as OAuth client.
GOOGLE_CLOUD_PROJECT_NUMBER=
# Use verified Google subject IDs, not email addresses. See first sign-in setup.
FAMILY_MEMBERS=[]
# Example (all server-side):
# FAMILY_MEMBERS=[{"googleSub":"123456789","displayName":"Daughter","spreadsheetId":"sheet-file-id","sheetId":0}]
# Enable only after supervised-account testing against a disposable sheet.
ENABLE_SHEET_WRITES=false
# Optional local-only UI preview with fictional data (ignored in production).
DEV_DEMO_MODE=false
